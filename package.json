    "axios": "^1.18.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.2.2",
    "next": "^16.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "4.11.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.13.14",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
